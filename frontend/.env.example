# Frontend build-time variables (Vite). Only VITE_* values are exposed to the browser.

# Leave VITE_API_URL empty: the app calls /api on its own origin, and Vercel (vercel.json)
# or the local Vite proxy forwards /api to the backend. Set a full URL only if you are NOT
# proxying and instead call the backend cross-origin (requires backend CORS + cookie changes).
VITE_API_URL=

# Optional public street basemap tiles (no credentials). Falls back to OpenStreetMap.
VITE_MAP_TILES=
