# Choose a random database password and URL-encode special characters for DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
AQUAPROOF_OFFICER_PASSWORD_HASH=
AQUAPROOF_SESSION_SECRET=
AQUAPROOF_SECURE_COOKIES=0
ASSISTANT_REPLY_SECRET=
# Comma-separated browser origins allowed to make write requests (no trailing slash).
# Set to your Vercel site when the frontend is hosted on a different origin, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=

AQUAPROOF_BACKGROUND_WHATSAPP=0
AQUAPROOF_HEALTH_ENABLED=1
ASSISTANT_ENABLED=0
ASSISTANT_SHARE_PRECISE_GEOMETRY=0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ARCGIS_API_KEY=
ARCGIS_BROWSER_TOKEN=
ARCGIS_SERVER_BASEMAPS=0
ARCGIS_DIGITIZATION_AUTHORIZED=0
OPENWEATHER_API_KEY=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Use http://waha:3000 with the optional Compose profile, or your private HTTPS WAHA origin.
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Optional browser-visible street tiles. Use a public URL without credentials.
VITE_MAP_TILES=
